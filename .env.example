# Spring Boot profile: debug または prod
SPRING_PROFILES_ACTIVE=debug


# GitHub OAuth App の作成: https://github.com/settings/developers

#   - Homepage URL:              http://localhost:3000

#   - Authorization callback URL: http://localhost:8080/login/oauth2/code/github

GITHUB_CLIENT_ID=sample_client_id

GITHUB_CLIENT_SECRET=sample_client_secret



# Google: https://console.cloud.google.com/apis/credentials

#   - 承認済みリダイレクトURI: http://localhost:8080/login/oauth2/code/google

GOOGLE_CLIENT_ID=sample_client_id

GOOGLE_CLIENT_SECRET=sample_client_secret


# DB
POSTGRESQL_HOSTNAME=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres


# Application
SERVER_PORT=8080
APP_SECURITY_PUBLIC_URL=http://localhost:3000
PENDING_REGISTRATION_TTL=30m


# LLM credential settings
# API_CREDENTIAL_ENCRYPTION_KEY は、ユーザーが入力したBYOK APIキーをDBへ暗号化保存するための鍵です。
# Base64形式の32バイトAES鍵を、開発・本番でそれぞれ異なる値として手動設定してください。
API_CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# デモ利用を有効にする場合だけ設定します。運営用APIキーの実値はコミットしないでください。
DEMO_LLM_API_KEY=
# デモ利用時のLLMのベースURL。未設定時は http://localhost:1234/v1 です。
DEMO_LLM_BASE_URL=http://localhost:1234/v1
# OPENAI または ANTHROPIC または DEMO。未設定時はDEMOです。
DEMO_LLM_PROVIDER=DEMO
# デモではこの固定モデルを利用します。未設定時はgoogle/gemma-4-e4bです。
DEMO_LLM_MODEL=google/gemma-4-e4b

# 本番環境でAWS Bedrockを利用する場合のリージョン設定。
AWS_REGION=

# BYOK利用者が画面で選択できるモデル一覧（カンマ区切り）。必要に応じて変更してください。
OPENAI_ALLOWED_MODELS=gpt-5-mini,gpt-4.1-mini
ANTHROPIC_ALLOWED_MODELS=claude-haiku-4-5,claude-sonnet-4-5

# Spring Boot profile: debug または prod
SPRING_PROFILES_ACTIVE=debug


# GitHub OAuth App の作成: https://github.com/settings/developers

#   - Homepage URL:              http://localhost:3000

#   - Authorization callback URL: http://localhost:8080/login/oauth2/code/github

GITHUB_CLIENT_ID=sample_client_id

GITHUB_CLIENT_SECRET=sample_client_secret



# Google: https://console.cloud.google.com/apis/credentials

#   - 承認済みリダイレクトURI: http://localhost:8080/login/oauth2/code/google

GOOGLE_CLIENT_ID=sample_client_id

GOOGLE_CLIENT_SECRET=sample_client_secret


# DB
POSTGRESQL_HOSTNAME=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres


# Application
SERVER_PORT=8080
APP_SECURITY_PUBLIC_URL=http://localhost:3000
PENDING_REGISTRATION_TTL=30m

